# 复制为 .env 并填入真实值（.env 已 gitignore，禁止提交）
API_KEY=你的key
API_BASE_URL=https://你的API服务地址/v1
MODEL_NAME=Qwen/Qwen3.5-35B

# 和风天气 JWT 凭据（控制台：项目/凭据页查 ID，设置页查开发者 ID）
QWEATHER_PRIVATE_KEY_PATH=backend/keys/ed25519-private.pem
QWEATHER_CREDENTIAL_ID=凭据ID_kid
QWEATHER_DEV_ID=开发者ID_iss_Q开头
QWEATHER_PROJECT_ID=项目ID_sub
QWEATHER_HOST=你的专属host.qweatherapi.com

# Neo4j 图数据库（第 5 期知识图谱）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=你的neo4j密码

# JWT 登录密钥（第 6 期注册登录；随机长串，泄露即可伪造登录态）
JWT_SECRET=你的随机密钥串
